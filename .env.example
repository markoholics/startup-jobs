# Supabase project — use the pooler connection's project URL, not the
# IPv6-only direct one. Service-role key is required (not anon) so
# collectors can write past RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Adzuna (developer.adzuna.com) free-tier credentials for the aggregator
# collector. Optional — leave blank to skip that source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
